<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BeatBuddySongMatcher.MainPage"
    Title="BeatBuddy Song Matching App"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- IMAGE DE FOND -->
        <Image
            Source="beatbuddy_background.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- VOILE BLANC TRANSPARENT -->
        <BoxView
            Color="White"
            Opacity="0.78"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- CONTENU -->
        <Grid
            Padding="20"
            RowDefinitions="Auto,Auto,*">

            <!-- TITRE -->
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="3"
                HorizontalOptions="Center"
                Margin="0,20,0,20">

                <Label
                    Text="BeatBuddy&#10; Song Matching App"
                    FontSize="26"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="Black" />

                <Label
                    Text="Unofficial companion app for BeatBuddy users"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="Black"
                    Opacity="0.7" />

                <Label
                    Text="Visit Singular Sound"
                    FontSize="12"
                    TextDecorations="Underline"
                    HorizontalTextAlignment="Center"
                    TextColor="Black">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSingularSoundTapped" />
                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>

            <!-- RECHERCHE -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="10">

                <SearchBar
                    x:Name="SearchBar"
                    Placeholder="Rechercher un artiste ou un titre..."
                    TextChanged="OnSearchTextChanged"
                    SearchButtonPressed="OnSearchButtonPressed"
                    TextColor="Black"
                    PlaceholderColor="Gray" />

                <CollectionView
                    x:Name="ResultsList"
                    SelectionMode="Single"
                    SelectionChanged="OnSongSelected"
                    MaximumHeightRequest="250">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Grid
                                Padding="12"
                                ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Grid.Column="0">

                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="Black" />

                                    <Label
                                        Text="{Binding Artist}"
                                        FontSize="14"
                                        TextColor="Black"
                                        Opacity="0.7" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Bpm, StringFormat='{0} BPM'}"
                                    VerticalOptions="Center"
                                    FontSize="13"
                                    TextColor="Black" />

                            </Grid>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <Label
                    x:Name="NoResultsLabel"
                    Text="Aucun morceau trouvé"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="Black"
                    IsVisible="False"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

            <!-- FICHE DU MORCEAU -->
            <Border
                Grid.Row="2"
                Margin="0,30,0,20"
                Padding="25"
                Stroke="Gray"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="1"
                BackgroundColor="#CCFFFFFF"
                VerticalOptions="Center">

                <VerticalStackLayout
                    Spacing="15"
                    HorizontalOptions="Center">

                    <Label
                        x:Name="SelectedSongLabel"
                        Text="Sélectionne un morceau"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="ArtistLabel"
                        Text=""
                        FontSize="17"
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />

                    <!-- BEAT -->
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <Label
                            Text="BEAT"
                            FontSize="14"
                            TextColor="Black"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="BeatLabel"
                            Text="—"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- BPM -->
                    <VerticalStackLayout
                        Spacing="2"
                        HorizontalOptions="Center">

                        <Label
                            Text="BPM"
                            FontSize="14"
                            TextColor="Black"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="BpmLabel"
                            Text="—"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>